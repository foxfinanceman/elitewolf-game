* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: #080b12;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
}

.game {
  width: 100%;
  max-width: 430px;
  padding: 30px 20px;
  text-align: center;
}

h1 {
  font-size: 38px;
  margin-bottom: 5px;
}

.subtitle {
  color: #aaa;
  margin-top: 0;
}

.wolf-box {
  margin: 30px auto 20px;
  width: 260px;
  height: 260px;
  border-radius: 25px;
  background: #111722;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 35px rgba(0, 140, 255, 0.25);
}

#wolf {
  font-size: 130px;
  animation: breathe 2s infinite ease-in-out;
}

@keyframes breathe {
  50% {
    transform: scale(1.06);
  }
}

h2 {
  margin: 10px 0;
}

.xp-bar {
  width: 100%;
  height: 18px;
  background: #202631;
  border-radius: 20px;
  overflow: hidden;
  margin-top: 15px;
}

#xp-fill {
  width: 0%;
  height: 100%;
  background: #168cff;
  transition: width 0.3s;
}

#xp-text {
  color: #aaa;
}

.buttons {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}

button {
  flex: 1;
  padding: 14px 8px;
  border: none;
  border-radius: 12px;
  background: #151c27;
  color: white;
  font-size: 15px;
  cursor: pointer;
  transition: 0.2s;
}

button:hover {
  transform: translateY(-2px);
  background: #202b3b;
}

#message {
  margin-top: 25px;
  color: #8bbfff;
}
